{
  "name": "uptime-monitor-server",
  "version": "1.0.0",
  "description": "Backend API & Worker Queue Engine for API Uptime Monitor (Stage 4)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:worker": "node src/worker.js",
    "dev:server": "node --watch server.js",
    "dev:worker": "node --watch src/worker.js",
    "dev": "concurrently -k -n \"SERVER,WORKER\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:worker\"",
    "test": "jest --detectOpenHandles --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
